    {
      "name": "Get Faction Units",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const units = pm.response.json();",
              "",
              "const librarian = units.find(",
              "    unit => unit.name === \"Brotherhood Librarian\"",
              ");",
              "",
              "if (librarian) {",
              "    pm.collectionVariables.set(\"unitId\", librarian.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
