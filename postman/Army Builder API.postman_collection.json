          "script": {
            "exec": [
              "const units = pm.response.json();\r",
              "\r",
              "const librarian = units.find(\r",
              "    unit => unit.name === \"Brotherhood Librarian\"\r",
              ");\r",
              "\r",
              "if (librarian) {\r",
              "    pm.collectionVariables.set(\"unitId\", librarian.id);\r",
